# Mode local de presentation. Copier manuellement vers .env.presentation
# uniquement si des valeurs locales distinctes de .env sont necessaires.
# Ne jamais versionner .env.presentation ni de vrais secrets.

APP_NAME="CEET - Gestion des Incidents"
APP_ENV=local
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_LOCALE=fr
APP_TIMEZONE=Africa/Lome

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gestion_incidents_ceet

QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=false

AUTH_ALLOW_PUBLIC_REGISTRATION=false

MAIL_MAILER=log

# Comptes locaux. Laisser vide dans Git et renseigner uniquement dans
# .env.presentation ou répondre aux questions interactives de la commande.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_SUPERVISOR_EMAIL=
DEMO_SUPERVISOR_PASSWORD=
DEMO_OPERATOR_EMAIL=
DEMO_OPERATOR_PASSWORD=
