# .env.testing.example
# Copy to .env.testing to run tests without MySQL/Docker dependency
# This file is loaded BEFORE phpunit.xml by tests/bootstrap.php

APP_NAME="CEET - Gestion des Incidents (Testing)"
APP_ENV=testing
APP_KEY=base64:0fejJa7o031/IC0Jf26fTLPhAkKXZdWC7wuNE5jtZ4U=
APP_DEBUG=true

# SQLite in-memory: No disk I/O, ultra-fast tests
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

# Array cache: Fast, non-persistent (ideal for tests)
CACHE_STORE=array

# Array session: No database writes
SESSION_DRIVER=array

# Sync queue: Execute jobs immediately, no workers
QUEUE_CONNECTION=sync

# Array mail: Capture emails in tests
MAIL_MAILER=array

# Faster bcrypt for test user creation
BCRYPT_ROUNDS=4
